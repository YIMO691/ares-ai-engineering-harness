<Project>
<PropertyGroup>
<TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
<TreatWarningsAsErrors>true</TreatWarningsAsErrors><UseArtifactsOutput>true</UseArtifactsOutput>
<ArtifactsPath Condition="'$(AresArtifactsRoot)' != ''">$(AresArtifactsRoot)</ArtifactsPath>
</PropertyGroup>
<Target Name="RequireExternalArtifacts" BeforeTargets="PrepareForBuild" Condition="'$(AresArtifactsRoot)' == ''"><Error Text="Set -p:AresArtifactsRoot to an authorized external scratch directory." /></Target>
</Project>
